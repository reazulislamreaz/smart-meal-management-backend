# Core Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="Smart Meal Management API"

# Database Connection (PostgreSQL 17)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_meal_db?schema=public&sslmode=disable"

# Redis Cache & Queue Connection (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Tokens
JWT_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRATION=7d
HMAC_SESSION_SECRET=your_hmac_session_secret

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Setup (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Smart Meal Management <no-reply@smartmeal.com>"
