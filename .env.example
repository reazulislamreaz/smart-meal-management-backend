# Core Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="Smart Meal Management API"
APP_URL=https://reaz3000.syedbipul.me

# Comma-separated browser origins allowed to call the API (admin dashboard on VPS).
CORS_ORIGINS=http://206.162.244.11:9173,https://reaz3000.syedbipul.me

# Database Connection (PostgreSQL 17)
# Inside Docker the backend uses postgres:5432 (see docker-compose.yml).
# From the host / VPS, use the published port (default 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/smart_meal_db?schema=public&sslmode=disable"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_meal_db

# Redis Cache & Queue Connection (Redis 7)
# Inside Docker the backend uses redis:6379.
# From the host / VPS, use the published port (default 6380).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Docker host port mappings (production/VPS).
# App listens on PORT=3000 inside the container; host maps 8888 → 3000.
# Production URL: http://<host>:8888/api/v1
# Local nest (`npm run start:dev`) still uses PORT=3000.
BACKEND_HOST_PORT=8888
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# JWT Secrets & Tokens
JWT_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRATION=7d
HMAC_SESSION_SECRET=your_hmac_session_secret

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Setup (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password
APP_USER_EMAIL=your_gmail@gmail.com
APP_PASSWORD=your_16_digit_app_password
EMAIL_FROM="Smart Meal Management <no-reply@smartmeal.com>"

# AI Integration
CHATGPT_OPENAI_KEY=your_openai_api_key

# AWS S3 Storage
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
